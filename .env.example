# --- required ---
# Long random secret for the API + MCP endpoint. Generate one with:  openssl rand -hex 32
HUB_TOKEN=
# Fine-grained GitHub token, read-only: Repository access "All repositories",
# permissions Contents: Read, Pull requests: Read, Metadata: Read.
GITHUB_TOKEN=

# --- optional ---
# Web UI password (defaults to HUB_TOKEN)
ADMIN_PASSWORD=
# The URL people/agents reach this app on (used for copy-paste snippets)
PUBLIC_URL=http://localhost:8787
PORT=8787
# Your name, shown in the context bundle ("Context for Alex")
OWNER_NAME=
# GitHub account to sync (empty = the token's own account)
GITHUB_OWNER=
# Timezone for activity-log dates (IANA name, e.g. Europe/Berlin, America/New_York)
TIMEZONE=UTC
SYNC_WINDOW_DAYS=60
# Sync automatically every N minutes (0 = only when you press Sync). An idle check is ~2 GitHub API calls.
AUTO_SYNC_MINUTES=5
INCLUDE_FORKS=false
DATA_DIR=./data

# --- optional: rate limits (0 = off) ---
# Failed logins per IP / in total, per 15 minutes
LOGIN_MAX_FAILS=10
LOGIN_MAX_FAILS_TOTAL=50
# Wrong tokens per IP per 15 minutes before 429 (a valid token is never blocked)
BAD_TOKEN_MAX=30
# Requests per minute per app (connection)
RATE_LIMIT_PER_MINUTE=600
# Which proxies may set the client IP: loopback = a proxy on this machine (Tailscale Funnel, cloudflared, Caddy)
TRUST_PROXY=loopback

# --- optional: Google Doc mirror (for Gemini) ---
# The Doc ID from its URL (docs.google.com/document/d/<ID>/edit). Leave empty to turn the mirror off.
GOOGLE_DOC_ID=
# Service-account JSON key. If this file doesn't exist and the hub runs on a Google Cloud VM, it uses keyless
# auth (the VM runs as the service account). Either way, share the Doc with the service account's email as Editor.
GOOGLE_SA_KEY_FILE=./google-sa.json
# Seconds to wait after the last change before updating the Doc
GDOC_DEBOUNCE_SECONDS=30
